<?xml version="1.0" encoding="utf-8"?>
<!--
  Allows plain HTTP only to the dev/staging raw-IP deploy
  (docs/DEPLOYMENTS.md — Caddy/TLS is still pending, docs/DOMAIN_AND_SSL.md).
  Every other domain stays HTTPS-only (base-config's cleartextTrafficPermitted
  defaults to false). Once a real HTTPS domain exists, drop this whole file
  and lib/data/api_client.dart's base URL switches to it — see
  docs/mobile/FLUTTER_APP_PLAN.md Phase 2/5.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">204.168.249.99</domain>
    </domain-config>
</network-security-config>
