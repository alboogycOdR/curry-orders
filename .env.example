# Curry Takeaway Ordering System — environment variables
# See docs/SPEC_v1.1.md Appendix D for the authoritative list and §17.4 for
# secrets handling. Real values live only in /srv/curry-orders/.env on
# Clawsrv (mode 0600) and in local .env files — never committed.

# --- Django core ---------------------------------------------------------
DJANGO_SECRET_KEY=changeme-generate-a-real-secret
DJANGO_ENV=dev
DATABASE_URL=postgres://curry:curry@db:5432/curry
TIME_ZONE=Africa/Johannesburg
SITE_URL=http://localhost:8102

# --- Hosting (Clawsrv, D-28 / §17.5) --------------------------------------
WEB_BIND_PORT=8102
MINIO_API_BIND_PORT=8103

# --- Object storage (self-hosted MinIO, D-28) -----------------------------
S3_ENDPOINT=http://minio:9000
S3_PUBLIC_ENDPOINT=https://media.example.co.za
S3_REGION=us-east-1
S3_ACCESS_KEY=changeme
S3_SECRET_KEY=changeme
S3_BUCKET_PROOFS=curry-proofs
S3_BUCKET_PUBLIC=curry-media
CDN_BASE_URL=

# MinIO container bootstrap only (rotate after service-account keys exist)
MINIO_ROOT_USER=changeme
MINIO_ROOT_PASSWORD=changeme

# --- Backups (§15, §17.1) -------------------------------------------------
BACKUP_TARGET=changeme-off-clawsrv-destination
BACKUP_ENCRYPTION_KEY=changeme

# --- Observability ---------------------------------------------------------
SENTRY_DSN=
GUNICORN_WORKERS=3
LOG_LEVEL=INFO

# --- SMS (optional, D-07) ---------------------------------------------------
SMS_PROVIDER=
SMS_API_KEY=
SMS_SENDER_ID=
