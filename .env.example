# Curry Takeaway Ordering System — environment variables
# See docs/SPEC_v1.1.md Appendix D for the authoritative list and §17.4 for
# secrets handling. Real values live only in /srv/curry-orders/.env on
# Clawsrv (mode 0600) and in local .env files — never committed.

# --- Django core ---------------------------------------------------------
DJANGO_SECRET_KEY=changeme-generate-a-real-secret
DJANGO_ENV=dev
# prod only: set to false for the interim raw-IP:port deploy with no TLS
# anywhere in front yet (see settings/prod.py's own docstring for why).
DJANGO_TLS=true
DATABASE_URL=postgres://curry:curry@db:5432/curry
TIME_ZONE=Africa/Johannesburg
SITE_URL=http://localhost:8102

# --- Hosting (Clawsrv, D-28 / §17.5) --------------------------------------
# WEB_BIND_HOST: leave unset (defaults to 127.0.0.1, loopback-only, host
# Caddy reverse-proxies in) once a real domain + Caddy site block exist.
# Set to 0.0.0.0 only for an interim raw-IP:port deploy with no Caddy in
# front yet.
WEB_BIND_HOST=127.0.0.1
WEB_BIND_PORT=8102
MINIO_API_BIND_PORT=8103

# --- Object storage (self-hosted MinIO, D-28) -----------------------------
S3_ENDPOINT=http://minio:9000
S3_PUBLIC_ENDPOINT=https://media.example.co.za
S3_REGION=us-east-1
S3_ACCESS_KEY=changeme
S3_SECRET_KEY=changeme
S3_BUCKET_PROOFS=curry-proofs
S3_BUCKET_PUBLIC=curry-media
CDN_BASE_URL=

# MinIO container bootstrap only (rotate after service-account keys exist)
MINIO_ROOT_USER=changeme
MINIO_ROOT_PASSWORD=changeme

# --- Backups (§15, §17.1) -------------------------------------------------
BACKUP_TARGET=changeme-off-clawsrv-destination
BACKUP_ENCRYPTION_KEY=changeme

# --- Observability ---------------------------------------------------------
SENTRY_DSN=
GUNICORN_WORKERS=3
LOG_LEVEL=INFO

# --- SMS (optional, D-07) ---------------------------------------------------
SMS_PROVIDER=
SMS_API_KEY=
SMS_SENDER_ID=

# --- Google OAuth2 (D-35) -------------------------------------------------
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorised redirect URIs must include:
#   http://localhost:8102/account/auth/google/callback/  (dev)
#   https://yourdomain/account/auth/google/callback/  (prod)
#   http://localhost:8102/manage/auth/google/callback/  (dev staff)
#   https://yourdomain/manage/auth/google/callback/  (prod staff)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
ADMIN_EMAIL=nuburo@gmail.com

# --- Email / magic links (D-36) -------------------------------------------
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=noreply@yoursite.com
MAGIC_LINK_EXPIRY_MINUTES=15
